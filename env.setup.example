# Copy this to .env.setup (same directory as setup.sh) and fill in real values.
# .env.setup should NOT be committed — add it to .gitignore.

# --- OpenTelemetry Collector destination ---
# Where Node Exporter's metrics get forwarded.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/metrics
OTEL_AUTH_HEADER=base64-encoded-user:pass

# --- Cloudflare Tunnel ---
# Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel -> Docker.
# Copy the token out of the install command it shows you (the long string
# after "run --token"). Then, in the same tunnel's config, add a Public
# Hostname for your domain pointing at: http://traefik:80
CF_TUNNEL_TOKEN=eyJhIjoiOi...
