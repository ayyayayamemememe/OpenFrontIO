# Copy this to .env.app (repo root) and fill in DOMAIN. Then just run
# ./redeploy.sh from here on — this file doesn't change between deploys.

# dev mode: accounts fall back to persistentID checks instead of full JWT/API-key
# auth (see docs/Auth.md), and skips needing OpenFront's own account API. Good
# enough for a personal self-hosted instance. Faster game-creation cadence too.
GAME_ENV=dev

# How many game-worker processes to run (ports 3001, 3002, ... internally).
# 2 is the repo's own dev default; bump it if your box has cores to spare.
NUM_WORKERS=2

# Cloudflare's published *test* Turnstile sitekey — always passes, no account
# needed. Get a real one from the Cloudflare dashboard if you want actual
# anti-bot checks later.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Only used by the admin-bot HTTP API and the internal API_KEY check — fine as
# an arbitrary string for a personal instance.
API_KEY=change-me-to-a-random-string

# Leave empty to disable the admin-bot HTTP API entirely.
ADMIN_BOT_API_KEY=

# Set to the hostname you pointed your Cloudflare Tunnel at (e.g. play.example.com).
DOMAIN=your-domain.com
